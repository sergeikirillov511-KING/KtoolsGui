<Window x:Class="KtoolsGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ktools GUI" Height="800" Width="1000"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Icon="Assets/KtoolGUI_Backround.ico">

    <Window.Background>
        <ImageBrush ImageSource="Assets/10th_Anniversary_Celebration.png" Stretch="UniformToFill"/>
    </Window.Background>


    <Window.Resources>
        
        <!-- Стили для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стили для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стили для TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu x:Name="MainMenu" Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Помощь">
                <MenuItem Header="О программе" Click="AboutMenuItem_Click"/>
                <MenuItem Header="Язык / Language">
                    <MenuItem Header="Русский" Click="LangRu_Click"/>
                    <MenuItem Header="English" Click="LangEn_Click"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="20">
            <TabControl x:Name="MainTabControl" Background="#F5F5F5" BorderThickness="0" Cursor="">
                
                <!-- Вкладка: Текстуры -->
                <TabItem Header="📁 Текстуры" FontSize="14" Padding="10,5">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="TexDirectTitle" Text="🔄 Прямая конвертация (.tex → .png)" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TexInputTextLabel" Text="📂 Входная папка (.tex):" VerticalAlignment="Center" Width="160" FontWeight="SemiBold"/>
                                <TextBox x:Name="TexInputFolderBox" Height="30" Width="380"/>
                                <Button x:Name="TexInputFolderButton" Content="Выбрать" Width="100" Click="TexInputFolderButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TexOutputTextLabel" Text="📤 Выходная папка (.png):" VerticalAlignment="Center" Width="180" FontWeight="SemiBold"/>
                                <TextBox x:Name="TexOutputFolderBox" Height="30" Width="380"/>
                                <Button x:Name="TexOutputFolderButton" Content="Выбрать" Width="100" Click="TexOutputFolderButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="3" x:Name="ConvertTexturesButton" Content="🚀 Конвертировать .tex → .png"
                HorizontalAlignment="Left"
                FontSize="14"
                FontWeight="SemiBold"
                Click="ConvertTexturesButton_Click"
                Margin="0,5,0,15"
                Height="40" Width="250"/>

                        <TextBlock Grid.Row="4" x:Name="TexBackTitle" Text="🔄 Обратная конвертация (.png → .tex)" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border Grid.Row="5" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TexBackInputTextLabel" Text="📂 Входная папка (.png):" VerticalAlignment="Center" Width="160" FontWeight="SemiBold"/>
                                <TextBox x:Name="TexBackInputFolderBox" Height="30" Width="380"/>
                                <Button x:Name="TexBackInputFolderButton" Content="Выбрать" Width="100" Click="TexBackInputFolderButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="6" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TexBackOutputTextLabel" Text="📤 Выходная папка (.tex):" VerticalAlignment="Center" Width="180" FontWeight="SemiBold"/>
                                <TextBox x:Name="TexBackOutputFolderBox" Height="30" Width="380"/>
                                <Button x:Name="TexBackOutputFolderButton" Content="Выбрать" Width="100" Click="TexBackOutputFolderButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="7" x:Name="ConvertTexturesBackButton" Content="🔄 Собрать .png → .tex"
                HorizontalAlignment="Left"
                FontSize="14"
                FontWeight="SemiBold"
                Click="ConvertTexturesBackButton_Click"
                Margin="0,5,0,10"
                Height="40" Width="250"/>

                        <TextBox Grid.Row="8" x:Name="TexLogBox"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="#FAFAFA"
                 BorderBrush="#E0E0E0"
                 Padding="10"
                 Margin="0,5,0,0"/>
                    </Grid>
                </TabItem>

                <!-- Вкладка: Анимации -->
                <TabItem Header="🎬 Анимации" FontSize="14" Padding="10,5">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Прямая конвертация (.bin → PNG) -->
                        <TextBlock Grid.Row="0" x:Name="AnimExtractTitle" Text="🔄 Извлечение анимаций" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AnimInputTextLabel" Text="📂 Исходная папка:" VerticalAlignment="Center" Width="160" FontWeight="SemiBold"/>
                                <TextBox x:Name="AnimBuildFolderBox" Height="30" Width="380"/>
                                <Button x:Name="AnimBuildFolderButton" Content="Выбрать" Width="100" Click="AnimBuildFolderButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AnimOutputTextLabel" Text="📤 Выходная папка:" VerticalAlignment="Center" Width="160" FontWeight="SemiBold"/>
                                <TextBox x:Name="AnimOutputFolderBox" Height="30" Width="380"/>
                                <Button x:Name="AnimOutputFolderButton" Content="Выбрать" Width="100" Click="AnimOutputFolderButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="3" x:Name="ConvertAnimationsButton" Content="🚀 Извлечь (anim.bin и build.bin + .tex)"
                HorizontalAlignment="Left"
                FontSize="14"
                FontWeight="SemiBold"
                Click="ConvertAnimationsButton_Click"
                Margin="0,5,0,15"
                Height="40" Width="300"/>

                        <!-- Обратная конвертация (требуется Spriter) -->
                        <TextBlock Grid.Row="4" x:Name="AnimAssemblyTitle" Text="⚠️ Сборка анимаций" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="5" x:Name="AnimSpriterText1" Text="❗ Для сборки анимаций обратно в .bin" 
                   FontSize="12" FontStyle="Italic" Margin="0,0,0,5" Foreground="#CC0000"/>

                        <TextBlock Grid.Row="6" x:Name="AnimSpriterText2" Text="   требуется Spriter (http://www.brashmonkey.com/spriter.htm)" 
                   FontSize="12" FontStyle="Italic" Margin="0,0,0,10" Foreground="#666666"/>

                        <Button Grid.Row="7" x:Name="DownloadSpriterButton" Content="📥 Скачать Spriter"
                HorizontalAlignment="Left"
                FontSize="14"
                FontWeight="SemiBold"
                Click="DownloadSpriterButton_Click"
                Margin="0,5,0,10"
                Height="40" Width="250"/>

                        <TextBox Grid.Row="8" x:Name="AnimLogBox"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="#FAFAFA"
                 BorderBrush="#E0E0E0"
                 Padding="10"
                 Margin="0,5,0,0"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>