<Window x:Class="KtoolsGui.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Ktools" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="VersionText" Text="Версия 4.5.1" FontSize="14" HorizontalAlignment="Center" Margin="0,5"/>
            <TextBlock x:Name="DescText" Text="Программа для обработки текстур и анимаций" FontSize="12" HorizontalAlignment="Center" Margin="0,15"/>
            <TextBlock Text="© 2026" FontSize="11" HorizontalAlignment="Center" Margin="0,20"/>
            <Button x:Name="CloseBtn" Content="Закрыть" Width="100" Height="30" Margin="0,20" HorizontalAlignment="Center" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>